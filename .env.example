# LLM provider: openai or gemini
PAPERPODS_LLM_PROVIDER=openai
PAPERPODS_SCRIPT_LENGTH_MODE=capped

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# TTS provider: elevenlabs or gemini
PAPERPODS_TTS_PROVIDER=elevenlabs

# ElevenLabs configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Gemini TTS configuration
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE_NAME=Bodi
# Optional style hint for Gemini speech metadata
GEMINI_TTS_STYLE=natural, clear Received Pronunciation British English
# Output format for Gemini TTS: mp3 or wav (mp3 requires ffmpeg installed)
GEMINI_TTS_OUTPUT_FORMAT=mp3

# Optional data location
PAPERPODS_DATA_DIR=~/.paperpods
